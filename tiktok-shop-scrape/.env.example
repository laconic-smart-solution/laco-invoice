# HTTP API (same marketplace contract as tiktok-service)
TIKTOK_SCRAPE_PORT=8090
GATEWAY_SECRET=hello

# Seller Center region (TH example)
TIKTOK_SELLER_CENTER_URL=https://seller-th.tiktok.com
# Partner Center — login.py --mode partner starts here, then switches into seller shop
TIKTOK_PARTNER_CENTER_URL=https://partner.tiktokshop.com

# laco-invoice — Playwright sessions stored in Oracle `tiktok_seller_sessions`
LACO_INVOICE_URL=http://localhost:8091

# Headless browser for order/product scrape
PLAYWRIGHT_HEADLESS=true
